  "scripts": {
    "build": "next build",
    "bx": "rimraf .next && npm run build && npm start",
    "check": "ultracite check",
    "clean": "rimraf .next",
    "db:check:dev": "drizzle-kit check --config=drizzle-dev.config.ts",
    "db:check:prod": "drizzle-kit check --config=drizzle-prod.config.ts",
    "db:generate:dev": "drizzle-kit generate --config=drizzle-dev.config.ts",
    "db:generate:prod": "drizzle-kit generate --config=drizzle-prod.config.ts",
    "db:migrate:dev": "drizzle-kit migrate --config=drizzle-dev.config.ts",
    "db:migrate:prod": "drizzle-kit migrate --config=drizzle-prod.config.ts",
    "db:push:dev": "drizzle-kit push --config=drizzle-dev.config.ts",
    "db:push:prod": "drizzle-kit push --config=drizzle-prod.config.ts",
    "db:seed": "npx tsx --env-file=.env.local ./src/drizzle/seed.ts",
    "db:studio:dev": "drizzle-kit studio --config=drizzle-dev.config.ts",
    "db:studio:prod": "drizzle-kit studio --config=drizzle-prod.config.ts",
    "dev": "next dev",
    "dx": "rimraf .next && npm run dev",
    "email": "email dev --port 3001 --dir ./src/emails/templates",
    "email:build": "email build --dir ./src/emails/templates",
    "email:start": "email start",
    "fix": "ultracite fix",
    "format": "biome format --write",
    "lint": "biome check",
    "start": "next start",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:e2e:ui": "playwright test --ui"
  },
